#define ZMK_POINTING_DEFAULT_MOVE_VAL 600  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/behaviors.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        hrow: hrow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HROW-MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
            flavor = "balanced";
        };

        cls_win: cls_win {
            compatible = "zmk,behavior-tap-dance";
            label = "CLS_WIN";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_4>, <&macro_44>, <&kp LA(F4)>;
        };

        hold_layer: hold_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_LAYER";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
        };
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&lt {
    tapping-term-ms = <240>;
    quick-tap-ms = <150>;
    flavor = "balanced";
};

&mt {
    quick-tap-ms = <150>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        toggle_num_layer {
            bindings = <&tog 2>;
            key-positions = <28 29 30>;
        };

        to_default_layer {
            bindings = <&to 0>;
            key-positions = <34 35 36>;
        };

        end_remote {
            bindings = <&kp LC(LS(LA(Q)))>;
            key-positions = <14 15 16>;
        };

        ctrl+q {
            bindings = <&kp LC(Q)>;
            key-positions = <14 15>;
        };

        ctrl+a {
            bindings = <&kp LC(A)>;
            key-positions = <27 40>;
        };

        ctrl+z {
            bindings = <&kp LC(Z)>;
            key-positions = <40 41>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <0 1>;
        };

        auto_parenth {
            bindings = <&auto_parentheses>;
            key-positions = <43 44>;
        };

        auto_brkt {
            bindings = <&auto_bracket>;
            key-positions = <46 47>;
        };
    };

    macros {
        macro_44: macro_44 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_4 &kp NUMBER_4>;
            label = "MACRO_44";
        };

        auto_bracket: auto_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
            label = "AUTO_BRACKET";
        };

        auto_parentheses: auto_parentheses {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT>;
            label = "AUTO_PARENTHESES";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default {
            bindings = <
&kp ESC                &kp N1                &kp N2              &kp N3            &kp N4            &kp N5            &kp UP_ARROW     &kp N6           &kp N7               &kp N8                  &kp N9                    &kp N0                        &kp BACKSPACE
&kp TAB                &kp Q                 &kp W               &kp E             &kp R             &kp T             &kp DOWN_ARROW   &kp Y            &kp U                &kp I                   &kp O                     &kp P                         &kp BSLH
&hrow LEFT_SHIFT CAPS  &hrow LEFT_CONTROL A  &hrow LEFT_SHIFT S  &hrow LEFT_GUI D  &hrow LEFT_ALT F  &lt 3 G           &kp LEFT_ARROW   &kp H            &hrow LEFT_ALT J     &hrow LEFT_GUI K        &hrow LEFT_SHIFT L        &hrow LEFT_CONTROL SEMICOLON  &kp ENTER
&kp LCTRL              &kp Z                 &kp X               &kp C             &kp V             &kp B             &kp RIGHT_ARROW  &kp N            &kp M                &mt LEFT_BRACKET COMMA  &mt RIGHT_BRACKET PERIOD  &mt LS(SLASH) SLASH           &kp DEL
&none                  &mo 4                 &kp LEFT_GUI        &kp LEFT_ALT      &kp SPACE         &kp LEFT_SHIFT    &kp ENTER        &lt 1 RIGHT_ALT  &hold_layer 2 SPACE  &none                   &tog 2                    &mo 4
            >;

            display-name = "QWERTY";
        };

        Function_layer {
            bindings = <
&kp ESCAPE  &mt LC(LS(F1)) F1  &kp F2  &kp F3  &mt LA(F4) F4         &kp F5                   &mmv MOVE_UP     &kp F6             &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans      &trans             &trans  &trans  &trans                &trans                   &mmv MOVE_DOWN   &trans             &kp F4  &kp F5  &kp F6  &trans   &kp F12
&trans      &trans             &trans  &trans  &trans                &trans                   &mmv MOVE_LEFT   &kp LEFT_BRACKET   &kp F1  &kp F2  &kp F3  &trans   &trans
&trans      &trans             &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &mmv MOVE_RIGHT  &kp RIGHT_BRACKET  &trans  &trans  &trans  &trans   &trans
&trans      &trans             &trans  &trans  &trans                &trans                   &mkp LCLK        &trans             &trans  &trans  &trans  &trans
            >;

            label = "FUNC";
        };

        number_layer {
            display-name = "NUM";
            bindings = <
&to 0       &kp N1         &kp N2    &kp N3        &kp N4                &kp N5                   &mmv MOVE_UP     &kp N6             &kp N7        &kp N8        &kp N9        &kp PLUS              &trans
&trans      &kp PAGE_UP    &kp HOME  &kp UP_ARROW  &kp END               &kp PAGE_UP              &mmv MOVE_DOWN   &trans             &kp NUMBER_4  &kp N5        &kp NUMBER_6  &mt UNDERSCORE MINUS  &mt UNDERSCORE MINUS
&trans      &kp PAGE_DOWN  &kp LEFT  &kp DOWN      &kp RIGHT             &kp PAGE_DOWN            &mmv MOVE_LEFT   &kp LEFT_BRACKET   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ASTERISK          &kp SQT
&trans      &trans         &trans    &trans        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &mmv MOVE_RIGHT  &kp RIGHT_BRACKET  &kp N0        &kp N0        &kp PERIOD    &kp SLASH             &trans
&kp C_MUTE  &trans         &trans    &trans        &trans                &trans                   &mkp LCLK        &trans             &trans        &trans        &trans        &mt EQUAL ENTER
            >;
        };

        G_num_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp N6             &kp N7  &kp N8  &kp N9   &kp LSHFT             &kp N6
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans             &kp N4  &kp N5  &kp N6   &mt UNDERSCORE MINUS  &mt UNDERSCORE MINUS
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LEFT_BRACKET   &kp N1  &kp N2  &kp N3   &kp ASTRK             &kp SQT
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp RIGHT_BRACKET  &kp N0  &kp N0  &kp DOT  &kp FSLH              &kp ENTER
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans             &trans  &trans  &trans   &mt EQUAL ENTER
            >;
        };

        SYSTEM {
            label = "SYSTEM";
            bindings = <
&bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2       &bt BT_SEL 3    &bt BT_SEL 4    &kp C_VOLUME_UP    &trans           &trans           &trans           &trans           &trans           &trans
&out OUT_TOG  &trans        &trans        &kp C_VOLUME_UP    &kp C_BRI_UP    &trans          &kp C_VOLUME_DOWN  &trans           &trans           &trans           &trans           &trans           &trans
&trans        &trans        &trans        &kp C_VOLUME_DOWN  &kp C_BRI_DN    &trans          &kp C_BRI_DN       &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_EFF
&trans        &trans        &trans        &kp K_MUTE         &kp C_BRI_AUTO  &trans          &kp C_BRI_UP       &rgb_ug RGB_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_EFR
&trans        &trans        &trans        &trans             &trans          &trans          &kp C_MUTE         &trans           &trans           &trans           &trans           &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
